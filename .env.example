# Vercel dashboard'da Project -> Settings -> Environment Variables'a ekleyin.

# Supabase projenizin URL'i (https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase -> Settings -> API -> service_role (secret) key.
# DİKKAT: service role gizlidir, yalnızca server (api/) tarafında kullanın,
# GitHub'a veya frontend'e asla eklemeyin.
SUPABASE_SERVICE_ROLE_KEY=

# Seed çalıştırmak için doldurun (yoksa boş kalsın).
SUPABASE_ANON_KEY=