# Ortam değişkenleri şablonu.
#
# Bu değerler 3 yerde kullanılır:
#  1) Yerel test  -> .env dosyasına kopyala
#  2) Vercel      -> Project -> Settings -> Environment Variables
#  3) GitHub      -> Settings -> Secrets and variables -> Actions (MEB otomasyonu için)
#
# DİKKAT: Gizli anahtarı (SUPABASE_SERVICE_ROLE_KEY) asla:
#   - kod içine, index.html'e, Git'e, GitHub'a YAZMA.
#   - sohbet/chat'te paylaşma. (Anahtarın görüldüyse hemen yenile.)

# Supabase projenizin URL'i (https://xxxx.supabase.co)
# Gördüğün "Data API" URL değeri budur.
SUPABASE_URL=

# Supabase -> Settings -> API Keys -> Secret keys (veya Legacy -> service_role).
# Yeni format: sb_secret_...  Eski: eyJ...
# Yalnızca sunucu/backend tarafında kullanın.
SUPABASE_SERVICE_ROLE_KEY=